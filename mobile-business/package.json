{
  "name": "tap-in-business-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Tap In for Business phone app: a Capacitor shell around the Business console and gate scanner.",
  "scripts": {
    "assets": "capacitor-assets generate --android --assetPath assets",
    "sync": "cap sync",
    "android:build": "cap sync android && cd android && ./gradlew assembleDebug",
    "android:open": "cap open android"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0"
  }
}
